@inherits LayoutComponentBase
@inject AgentService AgentService
@inject LocalMediaCenterService LocalMediaCenter
@inject HomePageViewModel ViewModel
@inject NavigationManager Navigation
@implements IDisposable
@using BitRuisseau.Models.Protocol
@using InfiniLore.Lucide

<div class="app-container">
    <header>
        <h1>MediaPlayer</h1>
        <button @onclick="GoToSettings">Settings</button>
    </header>

    <div class="page-container">
        <aside class="sidebar">
            <ul>
                <li @onclick="OnClickMe">Moi</li>
                @foreach (var node in _nodes)
                {
                    <li @onclick="() => OnUserClicked(node)">@node.Name</li>
                }
            </ul>
        </aside>

        <main>@Body</main>
    </div>

    <footer class="bottom-player">
        @if (ViewModel.CurrentSong != null)
        {
            <div class="player-left">
                <div class="album-art-placeholder">
                    <LucideIcon Name="music" size="28" />
                </div>
                <div class="song-info">
                    <div class="song-title">@ViewModel.CurrentSong.Title.Shorten(50)</div>
                    <div class="song-artist">@string.Join(", ", ViewModel.CurrentSong.Artist)</div>
                    <div class="song-meta">
                        @ViewModel.CurrentSong.Year | @ViewModel.Elapsed.ToString(@"mm\:ss") : @ViewModel.CurrentSong.Duration.ToString(@"mm\:ss")
                    </div>
                </div>
            </div>

            <div class="player-center">
                <button @onclick="ViewModel.PlayPrevious" aria-label="Previous song">
                    <LucideIcon Name="arrow-left" />
                </button>

                @if (ViewModel.IsPlaying)
                {
                    <button class="play-button" @onclick="ViewModel.Pause" aria-label="Pause">
                        <LucideIcon Name="pause" />
                    </button>
                }
                else
                {
                    <button class="play-button" @onclick="() => ViewModel.Play(ViewModel.CurrentSong!)" aria-label="Play">
                        <LucideIcon Name="play" />
                    </button>
                }

                <button @onclick="ViewModel.PlayNext" aria-label="Next song">
                    <LucideIcon Name="arrow-right" />
                </button>
            </div>
        }
        else
        {
            <span>Select a song to play</span>
        }
    </footer>
</div>

@code {
    private List<MediaCenter> _nodes = new();
    private Action? _playerChangedHandler;

    /// <summary>
    /// Initializes the layout component, subscribes to events, and starts the AgentService.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        _playerChangedHandler = () => InvokeAsync(StateHasChanged);
        ViewModel.OnPlayerChanged += _playerChangedHandler;

        AgentService.NodesUpdated += OnNodesUpdated;
        await AgentService.StartAsync(LocalMediaCenter.Instance);
    }

    /// <summary>
    /// Updates the sidebar node list when AgentService notifies of changes.
    /// </summary>
    private void OnNodesUpdated(object? sender, IReadOnlyCollection<MediaCenter> list)
    {
        _nodes = list.ToList();
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Loads the local user's music list into the current playlist.
    /// </summary>
    private void OnClickMe()
    {
        ViewModel.CurrentMusicList.Clear();
        foreach (var song in ViewModel.MyMusicList)
        {
            ViewModel.CurrentMusicList.Add(song);
        }

        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Sends a catalog request to the selected MediaCenter.
    /// </summary>
    private async Task OnUserClicked(MediaCenter user)
    {
        await AgentService.SendEnvelopeAsync(
            new Envelope(LocalMediaCenter.Instance.Id, user.Id, MessageType.CATALOG_REQUEST, string.Empty),
            AgentService.BASE_TOPIC);
    }

    /// <summary>
    /// Unsubscribes from events and stops the AgentService when the component is disposed.
    /// </summary>
    public void Dispose()
    {
        if (_playerChangedHandler != null)
        {
            ViewModel.OnPlayerChanged -= _playerChangedHandler;
        }

        AgentService.NodesUpdated -= OnNodesUpdated;
        _ = AgentService.StopAsync();
    }

    private void GoToSettings()
    {
        Navigation.NavigateTo("/settings");
    }
}
