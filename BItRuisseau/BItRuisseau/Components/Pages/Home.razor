@page "/"
@inject SettingsService SettingsService
@inject MusicService MusicService

<div class="content-page">
    @if (string.IsNullOrWhiteSpace(SettingsService.Current.MusicFolderPath))
    {
        <p>Aucun dossier configuré. Veuillez en choisir un…</p>
        <button @onclick="SelectFolder">Choisir un dossier</button>
    }
    else
    {
        <div class="music-player">
            <aside class="music-list">
                <ul>
                    @foreach (var song in songs)
                    {
                        <li @onclick="() => PlaySong(song)" style="cursor:pointer;@(currentSong == song ? "font-weight:bold;" : "")">
                            @song.Title
                        </li>
                    }
                </ul>
            </aside>

            <div class="player">
                @if (currentSong != null)
                {
                    <p>Lecture en cours : @(string.IsNullOrEmpty(currentSong.Title) ? Path.GetFileName(currentSong.FilePath) : currentSong.Title)</p>
                    <p>
                        Status:
                        @if (IsPlaying)
                        {
                            <span>🎵 Playing</span>
                        }
                        else if (IsPaused)
                        {
                            <span>⏸ Paused</span>
                        }
                        else
                        {
                            <span>■ Stopped</span>
                        }
                    </p>

                    <button @onclick="() => PlaySong(currentSong)" disabled="@IsPlaying">Play</button>
                    <button @onclick="PauseSong" disabled="@(!IsPlaying)">Pause</button>
                    <button @onclick="StopSong" disabled="@IsStopped">Stop</button>
                }
                else
                {
                    <p>Sélectionnez une musique pour jouer</p>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<Music> songs = new();
    private Music currentSong;

    private NAudio.Wave.IWavePlayer waveOut;
    private NAudio.Wave.AudioFileReader audioFile;

    private bool IsPlaying => waveOut?.PlaybackState == NAudio.Wave.PlaybackState.Playing;
    private bool IsPaused => waveOut?.PlaybackState == NAudio.Wave.PlaybackState.Paused;
    private bool IsStopped => waveOut?.PlaybackState == NAudio.Wave.PlaybackState.Stopped || waveOut == null;

    protected override void OnInitialized()
    {
        LoadSongs();
    }

    private async Task SelectFolder()
    {
        bool picked = await SettingsService.PickMusicFolderAsync();
        if (picked)
        {
            LoadSongs();
            StateHasChanged();
        }
    }

    private void LoadSongs()
    {
        if (!string.IsNullOrWhiteSpace(SettingsService.Current.MusicFolderPath))
        {
            songs = MusicService.GetMusics(SettingsService.Current.MusicFolderPath);
        }
    }

    private void PlaySong(Music song)
    {
        try
        {
            if (IsPlaying && currentSong == song)
                return;

            StopSong();

            currentSong = song;
            audioFile = new NAudio.Wave.AudioFileReader(song.FilePath);
            waveOut = new NAudio.Wave.WaveOutEvent();
            waveOut.Init(audioFile);
            waveOut.Play();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error playing {song.FilePath}: {ex.Message}");
        }
    }

    private void PauseSong()
    {
        if (IsPlaying)
        {
            waveOut.Pause();
        }
    }

    private void StopSong()
    {
        if (waveOut != null)
        {
            waveOut.Stop();
            audioFile?.Dispose();
            waveOut.Dispose();
            audioFile = null;
            waveOut = null;
        }
    }

    public void Dispose()
    {
        StopSong();
    }
}
