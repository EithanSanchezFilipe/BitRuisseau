@page "/"
@implements IDisposable
@inject SettingsService SettingsService
@inject HomePageViewModel ViewModel

<div class="content-page">
    @if (string.IsNullOrWhiteSpace(SettingsService.Current.MusicFolderPath))
    {
        <p>Aucun dossier sélectionné.</p>
        <button @onclick="SelectFolder">Choisir un dossier</button>
    }
    else
    {
        <div class="music-player">
            <aside class="music-list-grid">
                @foreach (var song in ViewModel.CurrentMusicList)
                {
                    <div class="song-box @(ViewModel.CurrentSong == song ? "active" : "")"
                         @onclick="() => ViewModel.Play(song)">
                        <div class="song-image-placeholder"></div>
                        <p class="songTitle">@song.Title.Shorten(20)</p>
                        <p class="artistName">@string.Join(", ", song.Artist).Shorten(15)</p>
                    </div>
                }
            </aside>
        </div>
    }
</div>

@code {
    private Action? _playerChangedHandler;

    /// <summary>
    /// Initializes the page and subscribes to ViewModel events.
    /// Loads songs if a music folder is already configured.
    /// </summary>
    protected override void OnInitialized()
    {
        _playerChangedHandler = () => InvokeAsync(StateHasChanged);

        // Subscribe to music list changes and player state changes
        ViewModel.CurrentMusicList.CollectionChanged += (_, __) => InvokeAsync(StateHasChanged);
        ViewModel.OnPlayerChanged += _playerChangedHandler;

        if (!string.IsNullOrWhiteSpace(SettingsService.Current.MusicFolderPath))
        {
            ViewModel.LoadSongs(SettingsService.Current.MusicFolderPath);
        }
    }

    /// <summary>
    /// Opens a folder picker for the user to select a music folder.
    /// Loads the songs if a folder was successfully chosen.
    /// </summary>
    private async Task SelectFolder()
    {
        bool picked = await SettingsService.PickMusicFolderAsync();
        if (picked)
        {
            ViewModel.LoadSongs(SettingsService.Current.MusicFolderPath);
            StateHasChanged();
        }
    }

    /// <summary>
    /// Unsubscribes from events and disposes the ViewModel.
    /// </summary>
    public void Dispose()
    {
        if (_playerChangedHandler != null)
        {
            ViewModel.OnPlayerChanged -= _playerChangedHandler;
        }

        ViewModel.Dispose();
    }
}
