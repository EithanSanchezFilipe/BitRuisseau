@page "/settings"
@inject SettingsService SettingsService
@inject NavigationManager Navigation

<div class="settings-page">
    <h1>Settings</h1>
    <p>Current folder: @(SettingsService.Current.MusicFolderPath ?? "Not configured")</p>
    <button @onclick="ChangeFolder">Change Folder</button>
    <button @onclick="GoHome">Back to Home</button>
</div>

@code {
    /// <summary>
    /// Opens a folder picker to select a new music folder.
    /// </summary>
    private async Task ChangeFolder()
    {
        await SettingsService.PickMusicFolderAsync();
        StateHasChanged(); // Refresh the UI after folder selection
    }

    /// <summary>
    /// Navigates back to the home page.
    /// </summary>
    private void GoHome()
    {
        Navigation.NavigateTo("/");
    }
}
